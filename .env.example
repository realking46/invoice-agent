# Free AI reader: get a key at https://aistudio.google.com (Get API key). No card needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried when the main model is busy (503) or rate-limited (429); leave empty to skip
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Which AI reads invoices: gemini (free), claude (paid), or auto (whichever key is set, Gemini first)
LLM_PROVIDER=gemini
# auto = AI reader if a key is set, otherwise local OCR; llm = always AI; local = never AI
EXTRACTOR=auto
# Reuse the AI's reading of an identical file (saves free-tier quota, makes demo runs identical)
LLM_CACHE=1
# Optional, paid: Claude instead of Gemini
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Optional: protects a public URL (browser asks; any username, this password)
APP_PASSWORD=
